name: Build llama.cpp Android OpenCL Adreno

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout llama.cpp
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            cmake \
            ninja-build \
            git \
            unzip \
            wget

      - name: Setup Android NDK
        uses: android-actions/setup-android@v3

      - name: Install NDK
        run: |
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "ndk;27.2.12479018"

      - name: Configure
        env:
          ANDROID_NDK_HOME: ${{ env.ANDROID_NDK_HOME }}
        run: |
          cmake -S . -B build-android \
            -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_TOOLCHAIN_FILE="$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake" \
            -DANDROID_ABI=arm64-v8a \
            -DANDROID_PLATFORM=android-35 \
            -DANDROID_STL=c++_static \
            -DBUILD_SHARED_LIBS=OFF \
            \
            -DGGML_OPENCL=ON \
            -DGGML_OPENCL_USE_ADRENO_KERNELS=ON \
            -DGGML_OPENCL_EMBED_KERNELS=ON \
            \
            -DGGML_VULKAN=OFF \
            -DGGML_HEXAGON=OFF \
            \
            -DGGML_OPENMP=ON \
            \
            -DGGML_NATIVE=OFF \
            -DLLAMA_BUILD_TESTS=OFF \
            -DLLAMA_BUILD_EXAMPLES=ON \
            -DLLAMA_BUILD_SERVER=ON

      - name: Build
        run: |
          cmake --build build-android \
            --config Release \
            --parallel 2

      - name: Prepare Termux package
        run: |
          mkdir -p artifact/bin
          mkdir -p artifact/lib

          cp build-android/bin/llama-cli artifact/bin/ 2>/dev/null || true
          cp build-android/bin/llama-bench artifact/bin/ 2>/dev/null || true
          cp build-android/bin/llama-server artifact/bin/ 2>/dev/null || true

          find build-android -maxdepth 4 \
            -type f \
            \( -name "*.so" -o -name "*.dll" \) \
            -exec cp {} artifact/lib/ \; 2>/dev/null || true

          chmod +x artifact/bin/*

          cat > artifact/run-qwen3-30b.sh <<'EOF'
          #!/data/data/com.termux/files/usr/bin/bash

          DIR="$(cd "$(dirname "$0")" && pwd)"

          export LD_LIBRARY_PATH="$DIR/lib:/vendor/lib64:$LD_LIBRARY_PATH"

          MODEL="/sdcard/gguf/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf"

          exec "$DIR/bin/llama-cli" \
            --device GPUOpenCL \
            -m "$MODEL" \
            -c 2048 \
            -t 4 \
            -n 256 \
            -p "你好，请用中文介绍一下你自己。"
          EOF

          chmod +x artifact/run-qwen3-30b.sh

          cat > artifact/README-Termux.txt <<'EOF'
          llama.cpp Android OpenCL / Adreno

          Install:

          mkdir -p ~/llama-opencl
          cp -r bin lib run-qwen3-30b.sh ~/llama-opencl/

          chmod +x ~/llama-opencl/bin/*
          chmod +x ~/llama-opencl/run-qwen3-30b.sh

          Runtime:

          export LD_LIBRARY_PATH="$HOME/llama-opencl/lib:/vendor/lib64:$LD_LIBRARY_PATH"

          ~/llama-opencl/bin/llama-cli --list-devices

          Expected:

          GPUOpenCL: QUALCOMM Adreno(TM) ...

          Test:

          ~/llama-opencl/run-qwen3-30b.sh

          Benchmark:

          ~/llama-opencl/bin/llama-bench \
            --device GPUOpenCL \
            -m /sdcard/gguf/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf \
            -p 512 \
            -n 128
          EOF

      - name: Package
        run: |
          tar -czf llama.cpp-android-opencl-adreno.tar.gz artifact

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: llama.cpp-android-opencl-adreno
          path: llama.cpp-android-opencl-adreno.tar.gz
          retention-days: 14
